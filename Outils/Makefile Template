# **************************************************************************** #
#                                PROJECT CONFIG                                #
# **************************************************************************** #

MAKEFLAGS   += -s

NAME        = program_name

CC          = cc
CFLAGS      = -Wall -Wextra -Werror -g3

# **************************************************************************** #
#                                   SOURCES                                    #
# **************************************************************************** #

SRCS        = srcs/main.c \
              srcs/example.c

OBJS        = $(SRCS:.c=.o)

# **************************************************************************** #
#                                   HEADERS                                    #
# **************************************************************************** #

INCLUDES    = includes
HEADERS     = $(INCLUDES)/*.h

# **************************************************************************** #
#                                   LIBFT                                      #
# **************************************************************************** #

LIBFT_DIR   = libs/libft
LIBFT       = $(LIBFT_DIR)/libft.a

# **************************************************************************** #
#                                   RULES                                      #
# **************************************************************************** #

all: $(NAME)

$(NAME): $(OBJS) $(LIBFT)
	$(CC) $(CFLAGS) -I$(INCLUDES) -o $@ $^ $(LIBFT)

$(LIBFT):
	make -C $(LIBFT_DIR)

%.o: %.c
	$(CC) $(CFLAGS) -I$(INCLUDES) -c $< -o $@

clean:
	rm -f $(OBJS)
	make -C $(LIBFT_DIR) clean

fclean: clean
	rm -f $(NAME)
	make -C $(LIBFT_DIR) fclean

re: fclean all

# **************************************************************************** #
#                                   COLORS                                     #
# **************************************************************************** #

GREEN = \033[0;32m
BLUE  = \033[0;34m
RED   = \033[0;31m
RESET = \033[0m

# **************************************************************************** #
#                                CHECK NORM                                    #
# **************************************************************************** #

norm:
	echo "$(BLUE)==================================================$(RESET)"
	echo "$(BLUE)                CHECK NORM HEADERS                $(RESET)"
	echo "$(BLUE)==================================================$(RESET)"
	for file in $(HEADERS); do \
		norminette $$file | grep -q "OK!" && \
		echo "$$file: $(GREEN)OK!$(RESET)" || \
		norminette $$file; \
	done
	echo "$(BLUE)==================================================$(RESET)"
	echo "$(BLUE)                CHECK NORM SOURCES                $(RESET)"
	echo "$(BLUE)==================================================$(RESET)"
	for file in $(SRCS); do \
		norminette $$file | grep -q "OK!" && \
		echo "$$file: $(GREEN)OK!$(RESET)" || \
		norminette $$file; \
	done

# **************************************************************************** #
#                                  VALGRIND                                    #
# **************************************************************************** #

valgrind: $(NAME)
	echo "$(BLUE)==================================================$(RESET)"
	echo "$(BLUE)                 VALGRIND CHECK                   $(RESET)"
	echo "$(BLUE)==================================================$(RESET)"
	valgrind --leak-check=full \
	         --show-leak-kinds=all \
	         --track-origins=yes \
	         --track-fds=yes \
	         ./$(NAME) $(ARGS)

.PHONY: all clean fclean re norm valgrind
